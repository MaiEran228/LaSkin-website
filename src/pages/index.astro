---
/**
 * Root redirect: / -> /he/ (Hebrew is the default language; x-default).
 * Static hosts without server-side redirects (GitHub Pages) use this meta refresh;
 * hosts that read public/_redirects answer with a real 301 before this page is served.
 */
import { href, absoluteUrl } from '../lib/routes';
const target = href('he', 'home');
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>La Skin — הסרת שיער בלייזר בהר אדר</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absoluteUrl('he', 'home')} />
    <link rel="alternate" hreflang="he" href={absoluteUrl('he', 'home')} />
    <link rel="alternate" hreflang="ar" href={absoluteUrl('ar', 'home')} />
    <link rel="alternate" hreflang="en" href={absoluteUrl('en', 'home')} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl('he', 'home')} />
  </head>
  <body>
    <p><a href={target}>La Skin — עברית</a></p>
    <p lang="ar" dir="rtl"><a href={href('ar', 'home')}>La Skin — العربية</a></p>
    <p lang="en" dir="ltr"><a href={href('en', 'home')}>La Skin — English</a></p>
  </body>
</html>
