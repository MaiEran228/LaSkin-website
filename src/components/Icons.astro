---
/** Inline SVG icons. All are decorative (aria-hidden); the accessible name comes from surrounding text or aria-label. */
interface Props { name: 'wa' | 'phone' | 'menu' | 'close' | 'chevron' | 'arrow'; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
{name === 'wa' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M21 11.6a8.6 8.6 0 0 1-9.2 8.5 9 9 0 0 1-3.9-.9L3 21l1.9-4.7A8.6 8.6 0 0 1 3 11.6 8.8 8.8 0 0 1 12 3a8.8 8.8 0 0 1 9 8.6Z" />
    <path d="M9.2 8.6c.2 2.4 1.9 4.4 4.3 5.1l1.2-1.3 2.1 1-.2 1.4c-.2.7-.9 1.1-1.6 1a8 8 0 0 1-7-7c-.1-.7.3-1.4 1-1.6l1.4-.2 1 2.1-1.3 1.2Z" />
  </svg>
)}
{name === 'phone' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M5.5 3.5h3.2l1.6 4-2 1.3a11.5 11.5 0 0 0 6.4 6.4l1.3-2 4 1.6v3.2a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2Z" />
  </svg>
)}
{name === 'menu' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
)}
{name === 'close' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
    <path d="M6 6l12 12M18 6 6 18" />
  </svg>
)}
{name === 'chevron' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="m9 6 6 6-6 6" />
  </svg>
)}
{name === 'arrow' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M4 12h15m-6-6 6 6-6 6" />
  </svg>
)}
